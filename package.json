{
  "name": "hossambahr-service-registry",
  "private": true,
  "type": "module",
  "scripts": {
    "registry:validate": "node src/core/validate-registry.mjs",
    "registry:validate:publish": "node src/core/validate-registry.mjs --publish",
    "review:build-inventory": "node src/review/build-service-review-inventory.mjs",
    "review:test-discovery": "node src/review/test-dossier-discovery.mjs",
    "review:generate-preview": "node src/review/generate-service-preview.mjs",
    "review:test-preview-journey": "node src/review/test-preview-journey.mjs",
    "review:validate-progress": "node src/review/validate-progressive-review.mjs && node src/dashboard/generate-dashboards.mjs",
    "dashboard:generate": "node src/dashboard/generate-dashboards.mjs",
    "business:report": "node src/business/generate-business-report.mjs",
    "test:architecture": "node --test test/architecture/*.test.mjs"
