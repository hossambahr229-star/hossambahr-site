{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hossambahr.com/schemas/service.schema.json",
  "title": "HossamBahr Government Service",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "sourceLegacyIds",
    "slug",
    "name",
    "description",
    "audiences",
    "requestType",
    "emirateId",
    "authorityId",
    "category",
    "customerTypeIds",
    "activityIds",
    "licenseTypeIds",
    "classificationNumbers",
    "keywords",
    "documents",
    "governmentFees",
    "serviceFees",
    "conditions",
    "eligibility",
    "exceptions",
    "duration",
    "steps",
    "officialGovernmentLink",
    "officialSources",
    "relatedServiceIds",
    "alternativeServiceIds",
    "faq",
    "lastUpdated",
    "lastReviewedAt",
    "verification",
    "businessAcceptance",
    "lifecycle"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "sourceLegacyIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "$ref": "#/$defs/localizedRequired" },
    "description": { "$ref": "#/$defs/localizedRequired" },
    "audiences": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/localizedRequired" }
    },
    "requestType": { "$ref": "#/$defs/localizedRequired" },
    "emirateId": { "type": "string", "minLength": 1 },
    "authorityId": { "type": "string", "minLength": 1 },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mainId", "subId"],
      "properties": {
        "mainId": { "type": "string", "minLength": 1 },
        "subId": { "type": "string", "minLength": 1 }
      }
    },
    "customerTypeIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "activityIds": { "$ref": "#/$defs/nonEmptyUniqueIds" },
    "licenseTypeIds": { "$ref": "#/$defs/nonEmptyUniqueIds" },
    "classificationNumbers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "keywords": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ar", "en"],
      "properties": {
        "ar": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "en": { "$ref": "#/$defs/nonEmptyUniqueStrings" }
      }
    },
    "documents": { "$ref": "#/$defs/documentsSection" },
    "governmentFees": { "$ref": "#/$defs/feesSection" },
    "serviceFees": { "$ref": "#/$defs/feesSection" },
    "conditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/localizedRequired" }
    },
    "eligibility": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/localizedRequired" }
    },
    "exceptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/localizedRequired" }
    },
    "duration": { "$ref": "#/$defs/localizedRequired" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    },
    "officialGovernmentLink": { "$ref": "#/$defs/executionLink" },
    "officialSources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/officialSource" }
    },
    "relatedServiceIds": { "$ref": "#/$defs/uniqueIds" },
    "alternativeServiceIds": { "$ref": "#/$defs/uniqueIds" },
    "faq": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/faq" }
    },
    "lastUpdated": { "type": "string", "format": "date" },
    "lastReviewedAt": { "type": "string", "format": "date-time" },
    "verification": { "$ref": "#/$defs/verification" },
    "businessAcceptance": { "$ref": "#/$defs/acceptance" },
    "lifecycle": { "$ref": "#/$defs/lifecycle" }
  },
  "$defs": {
    "localizedRequired": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ar", "en"],
      "properties": {
        "ar": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "uniqueIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nonEmptyUniqueIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "required", "notes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "$ref": "#/$defs/localizedRequired" },
        "required": { "type": "boolean" },
        "notes": { "$ref": "#/$defs/localizedRequired" }
      }
    },
    "documentsSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "items", "notes"],
      "properties": {
        "status": { "type": "string", "enum": ["required", "not-required"] },
        "items": { "type": "array", "items": { "$ref": "#/$defs/document" } },
        "notes": { "$ref": "#/$defs/localizedRequired" }
      }
    },
    "fee": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "amount", "currency", "notes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "$ref": "#/$defs/localizedRequired" },
        "amount": { "type": ["number", "null"], "minimum": 0 },
        "currency": { "type": "string", "enum": ["AED", "VARIABLE", "NOT_APPLICABLE"] },
        "notes": { "$ref": "#/$defs/localizedRequired" }
      }
    },
    "feesSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "items", "notes"],
      "properties": {
        "status": { "type": "string", "enum": ["paid", "free", "variable"] },
        "items": { "type": "array", "items": { "$ref": "#/$defs/fee" } },
        "notes": { "$ref": "#/$defs/localizedRequired" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "title", "description"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "title": { "$ref": "#/$defs/localizedRequired" },
        "description": { "$ref": "#/$defs/localizedRequired" }
      }
    },
    "executionLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "url", "channel", "target", "official", "lastTestedAt", "testEvidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "$ref": "#/$defs/localizedRequired" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "channel": { "type": "string", "enum": ["web", "mobile-app", "service-center"] },
        "target": { "type": "string", "enum": ["exact-transaction", "exact-login", "exact-service-card"] },
        "official": { "const": true },
        "lastTestedAt": { "type": ["string", "null"], "format": "date-time" },
        "testEvidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "officialSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "title", "checkedAt"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "title": { "$ref": "#/$defs/localizedRequired" },
        "checkedAt": { "type": "string", "format": "date-time" }
      }
    },
    "faq": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "answer"],
      "properties": {
        "question": { "$ref": "#/$defs/localizedRequired" },
        "answer": { "$ref": "#/$defs/localizedRequired" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value", "capturedAt"],
      "properties": {
        "type": { "type": "string", "enum": ["screenshot", "http-log", "manual-log", "official-source"] },
        "value": { "type": "string", "minLength": 1 },
        "capturedAt": { "type": "string", "format": "date-time" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewedAt", "reviewer", "evidence", "notes"],
      "properties": {
        "status": { "type": "string", "enum": ["draft", "needs-information", "verified", "suspended"] },
        "reviewedAt": { "type": ["string", "null"], "format": "date-time" },
        "reviewer": { "type": ["string", "null"] },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "notes": { "$ref": "#/$defs/localizedRequired" }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvedAt", "routeCreatedAt", "registryInsertedAt", "relationshipsLinkedAt", "publishReadyAt"],
      "properties": {
        "approvedAt": { "type": "string", "format": "date-time" },
        "routeCreatedAt": { "type": "string", "format": "date-time" },
        "registryInsertedAt": { "type": "string", "format": "date-time" },
        "relationshipsLinkedAt": { "type": ["string", "null"], "format": "date-time" },
        "publishReadyAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "servicePage", "search", "journey", "manualTest"],
      "properties": {
        "status": { "type": "string", "enum": ["pending", "failed", "passed"] },
        "servicePage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["testedAt", "httpStatus", "nonEmpty", "evidence"],
          "properties": {
            "testedAt": { "type": ["string", "null"], "format": "date-time" },
            "httpStatus": { "type": ["integer", "null"] },
            "nonEmpty": { "type": ["boolean", "null"] },
            "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
          }
        },
        "search": {
          "type": "object",
          "additionalProperties": false,
          "required": ["testedAt", "methodsVerified", "evidence"],
          "properties": {
            "testedAt": { "type": ["string", "null"], "format": "date-time" },
            "methodsVerified": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "enum": ["name", "keywords", "authority", "emirate", "activity", "license-type", "classification-number", "related-service"] }
            },
            "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
          }
        },
        "journey": {
          "type": "object",
          "additionalProperties": false,
          "required": ["testedAt", "homeToExecutionClicks", "evidence"],
          "properties": {
            "testedAt": { "type": ["string", "null"], "format": "date-time" },
            "homeToExecutionClicks": { "type": ["integer", "null"], "minimum": 0, "maximum": 2 },
            "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
          }
        },
        "manualTest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["testedAt", "result", "tester", "evidence", "notes"],
          "properties": {
            "testedAt": { "type": ["string", "null"], "format": "date-time" },
            "result": { "type": "string", "enum": ["pending", "failed", "passed"] },
            "tester": { "type": ["string", "null"] },
            "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
            "notes": { "$ref": "#/$defs/localizedRequired" }
          }
        }
      }
    }
  }
}
